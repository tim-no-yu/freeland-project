SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=earthteam_stars
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=evidence

# Solana / EarthTeam Stars mint (devnet only for MVP)
# Generate a devnet keypair with:
#   solana-keygen new --no-bip39-passphrase -o mint-authority.json
# Then encode the secret as base58 for STARS_MINT_AUTHORITY_SECRET.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
STARS_MINT_ADDRESS=
STARS_MINT_AUTHORITY_SECRET=
STARS_MINT_DECIMALS=0
STARS_MINT_MAX_ATTEMPTS=5
STARS_MINT_BACKOFF_SECONDS=30
